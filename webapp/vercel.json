{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/s/:token", "destination": "/api/share-page?token=:token" },
    { "source": "/map", "destination": "/api/seo-page?p=map" },
    { "source": "/files/:path*", "destination": "https://gmwurbvhhzgdikogxiqb.supabase.co/storage/v1/object/sign/:path*" },
    { "source": "/media/:path*", "destination": "https://gmwurbvhhzgdikogxiqb.supabase.co/storage/v1/object/public/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!files/|media/).*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
